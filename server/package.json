{
  "name": "lazysplit-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "development-code:set": "node scripts/set-development-access-code.mjs",
    "secrets:rotate": "node scripts/rotate-local-secrets.mjs",
    "tunnel:adopt": "node scripts/adopt-cloudflare-tunnel.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.33.2"
}
